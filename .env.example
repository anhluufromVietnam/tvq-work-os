# AWS Configuration for zai.glm-5 model
# Copy this file to .env.local and fill in your AWS credentials

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# Option 1: Standard AWS Access Keys
# AWS Access Key ID - Get from AWS IAM Console
# https://console.aws.amazon.com/iam/home#/security_credentials
# AWS_ACCESS_KEY_ID=your_access_key_here

# AWS Secret Access Key - Get from AWS IAM Console
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Option 2: AWS Bearer Session Key (ABSK format)
# If you have a key starting with "ABSK", use this:
AWS_BEARER_KEY=your_absk_bearer_key_here

# Model ID (zai.glm-5 on AWS Bedrock)
# This is already configured in the API route
# BEDROCK_MODEL_ID=d4bc9dc0-fb29-4873-8e46-db4deada437a/zai.glm-5
